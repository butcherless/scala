{
  "automerge": true,
  "automergeType": "pr",
  "dependencyDashboard": true,
  "labels": [
    "type: dependencies"
  ],
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "No CI job starts this image, so a green PR says nothing about it",
      "matchPackageNames": ["confluentinc/cp-kafka"],
      "automerge": false
    }
  ],
  "sbt": {
    "enabled": true
  },
  "schedule": [
    "after 5pm every weekday"
  ]
}
